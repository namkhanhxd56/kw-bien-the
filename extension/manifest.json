{
  "manifest_version": 3,
  "name": "KW Biến Thể – Cerebro",
  "version": "0.1.9",
  "description": "Nhận job từ tool KW Biến Thể, lấy keyword ASIN đối thủ trên Cerebro (Helium 10) bằng phiên đăng nhập của Chrome này rồi gửi về tool.",
  "minimum_chrome_version": "111",
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "KW Biến Thể – Cerebro", "default_popup": "popup.html" },
  "permissions": ["storage", "alarms", "tabs", "scripting"],
  "host_permissions": [
    "https://*.helium10.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "content_scripts": [
    {
      "matches": ["https://*.helium10.com/*"],
      "js": ["capture-main.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["https://*.helium10.com/*"],
      "js": ["capture-relay.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
